# Buat file dengan nama Input_NIM.py
# Buat program untuik menghitung luas persegi panjang
# Nama variabel ditambah 4 digit nim terakhir contoh: panjang_1008
# Program ini menggunakan fungsi input () untuk meminta pengguna
# memasukkan nilai panjang dan lebar persegi panjang.
# Nilai yang dimasukkan akan dikonversi menjadi tipe data integer
panjang_1008 = input('Masukkan nilai panjang: ')
lebar_1008 = input('Masukkan nilai lebar: ')
luas_1008 = int(panjang_1008) * int(lebar_1008)
print("Luas =", luas_1008)                    